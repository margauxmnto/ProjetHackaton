<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_sdk_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sdk_status_unregistered"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_drone_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/connection_status_disconnected"
        android:textSize="16sp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_sdk_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_register_sdk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/register_sdk_button"
        app:layout_constraintTop_toBottomOf="@id/text_drone_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintTop_toBottomOf="@id/btn_register_sdk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Section d'information en temps réel -->
    <TextView
        android:id="@+id/text_telemetry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/telemetry_placeholder"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/separator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_victim_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/victim_status_placeholder"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/text_telemetry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>